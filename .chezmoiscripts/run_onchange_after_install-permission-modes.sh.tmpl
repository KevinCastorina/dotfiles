#!/bin/bash

# .chezmoiscripts/run_onchange_after_install-permission-modes.sh.tmpl
# Provisions the Pi-Bolt sandbox: the pi-permission-modes package
# (https://github.com/wynainfo/pi-permission-modes) plus, on Linux, the OS
# sandbox it drives.
#
# The "_after" in the name matters: chezmoi runs plain run_onchange_* scripts in
# alphabetical order of their target names, so "install-p*e*rmission-modes" would
# run *before* "install-p*i*-bolt" and find no pi-bolt on a fresh machine. After
# scripts run once every other script has finished, whatever it is called.
#
# No admin/root required:
#   - bubblewrap + socat come from Homebrew (the Linuxbrew prefix is user-owned;
#     both are bottles, nothing is compiled). macOS needs neither, it uses the
#     built-in sandbox-exec.
#   - the extension is a user-scope Pi-Bolt package under
#     ${PI_CODING_AGENT_DIR:-~/.pi/agent}/npm, so `pi-bolt install` does the npm work.
#   - ripgrep (the third Linux dependency) is already installed above.
#
# Modes: Default -> Plan Mode -> Build -> YOLO (alt+m, /perm <mode>); /sandbox
# prints the active configuration. Without bwrap/socat the sandboxed modes
# degrade to prompting only and say so in the footer.

{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}

set -o pipefail

echo "========================================"
echo "Installing Pi-Bolt permission modes"
echo "========================================"

if ! command -v brew >/dev/null 2>&1; then
    if [ -d "/home/linuxbrew/.linuxbrew" ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -d "$HOME/.linuxbrew" ]; then
        eval "$($HOME/.linuxbrew/bin/brew shellenv)"
    fi
fi
export PATH="/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$HOME/.local/bin:$PATH"

# Same config location as the managed shell rc (see .chezmoitemplates/shellrc.tmpl):
# a fresh machine has no rc yet, so chezmoi's environment needs it too.
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pi/agent}"

# 1. Linux sandbox dependencies: bubblewrap (the OS sandbox), socat (the
#    network bridge) and ripgrep (violation monitoring). If not here already,
#    install them with Homebrew (both are bottles).
{{ if eq .chezmoi.os "linux" -}}
if command -v bwrap >/dev/null 2>&1 && command -v socat >/dev/null 2>&1; then
    echo "✓ Sandbox deps present ($(bwrap --version 2>&1), $(socat -V 2>&1 | sed -n 2p))."
elif command -v brew >/dev/null 2>&1; then
    echo "Installing bubblewrap + socat via Homebrew (bottles)..."
    if brew install bubblewrap socat >/dev/null 2>&1; then
        echo "✓ $(bwrap --version 2>&1), $(socat -V 2>&1 | sed -n 2p)"
    else
        echo "⚠️  'brew install bubblewrap socat' failed. The sandboxed modes will"
        echo "    fall back to prompting only until both are on PATH."
    fi
else
    echo "⚠️  Homebrew not found, so bubblewrap/socat cannot be installed without"
    echo "    root. The sandboxed modes fall back to prompting only."
fi
{{ end -}}

# 2. The extension itself: a user-scope Pi-Bolt package (npm).
AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
if ! command -v pi-bolt >/dev/null 2>&1; then
    echo "⚠️  pi-bolt not found. Skipping the package install."
    echo "    Run it directly once Pi-Bolt is there: pi-bolt install npm:pi-permission-modes"
    exit 0
fi

if pi-bolt list 2>/dev/null | grep -q "pi-permission-modes"; then
    echo "✓ pi-permission-modes is already installed."
else
    # The npm output goes to a log: a registry/network failure must not look like
    # the same silent "skipping" message as a missing pi-bolt.
    LOG_DIR="$HOME/.cache/dotfiles"
    LOG="$LOG_DIR/pi-permission-modes.log"
    mkdir -p "$LOG_DIR"
    echo "Installing npm:pi-permission-modes (log: $LOG)..."
    if pi-bolt install npm:pi-permission-modes >"$LOG" 2>&1; then
        echo "✓ pi-permission-modes installed (under $AGENT_DIR/npm)."
    else
        echo "⚠️  'pi-bolt install npm:pi-permission-modes' failed. Last lines of $LOG:"
        tail -n 20 "$LOG" 2>/dev/null | sed 's/^/    /'
        echo "    Retry: pi-bolt install npm:pi-permission-modes"
    fi
fi

echo "Modes: alt+m cycles (Default -> Plan Mode -> Build -> YOLO), /perm <mode>"
echo "switches, /sandbox prints the active configuration."
echo "========================================"

{{ end -}}
