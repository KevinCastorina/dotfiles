#!/bin/bash

# .chezmoiscripts/run_before_20-install-linux-binaries.sh.tmpl
# Fallback for Linux: installs CLI tools via pre-built binaries, but only those
# that are still missing. 10-install-brew-packages runs before this script, so
# anything Homebrew managed to install is skipped here (that is why the Homebrew
# bin directories are added to PATH below).
#
# This script runs on EVERY 'chezmoi apply' (run_before_*, not run_onchange_*),
# so a download that failed last time is retried automatically. Every install is
# guarded by a `command -v` check, so a complete machine costs a few `command -v`
# calls. Set DOTFILES_SKIP_INSTALL=1 to skip it (and the other install scripts).
#
# No `set -e` on purpose: one dead download (404, network blip) must not abort
# `chezmoi apply` - that would leave the later scripts and the dotfiles
# themselves unapplied. Failures are collected and reported at the end, and the
# failure itself makes the next run retry it.

{{ if eq .chezmoi.os "linux" }}

set -o pipefail

if [ "${DOTFILES_SKIP_INSTALL:-0}" = "1" ]; then
    echo "Skipping the pre-built binaries (DOTFILES_SKIP_INSTALL=1)."
    exit 0
fi

BIN_DIR="$HOME/.local/bin"
FAILED=""

# Record a tool that is still missing after this run (space separated).
fail_tool() {
    FAILED="$FAILED $1"
}

mkdir -p "$BIN_DIR"

# Homebrew ran first (see 10-install-brew-packages): put its bin
# directories on PATH so that `command -v` below sees what it installed and we
# do not download a second copy of the same tool.
for brew_bin in "$HOME/.linuxbrew/bin" "/home/linuxbrew/.linuxbrew/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
    if [ -d "$brew_bin" ]; then
        PATH="$brew_bin:$PATH"
    fi
done
export PATH="$BIN_DIR:$HOME/.fzf/bin:$PATH"

echo "========================================"
echo "Installing Linux Binaries (No-Admin)"
echo "========================================"

# Detect Architecture
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        echo "Detected architecture: x86_64"
        RG_ARCH="x86_64-unknown-linux-musl"
        BAT_ARCH="x86_64-unknown-linux-musl"
        EZA_ARCH="x86_64-unknown-linux-gnu"
        FD_ARCH="x86_64-unknown-linux-musl"
        ;;
    aarch64|arm64)
        echo "Detected architecture: aarch64"
        RG_ARCH="aarch64-unknown-linux-gnu"
        BAT_ARCH="aarch64-unknown-linux-musl"
        EZA_ARCH="aarch64-unknown-linux-gnu"
        FD_ARCH="aarch64-unknown-linux-musl"
        ;;
    *)
        echo "⚠️  Unsupported architecture: $ARCH - skipping the binary installs."
        echo "    Get the tools from Homebrew (see 10-install-brew-packages) or your"
        echo "    package manager; the health check lists whatever stays missing."
        exit 0
        ;;
esac

# Helper function to download and extract
install_binary() {
    local NAME=$1
    local URL=$2
    local BIN_NAME=$3
    local CMD_NAME=${4:-$NAME}

    if command -v "$CMD_NAME" >/dev/null 2>&1; then
        echo "✓ $NAME is already installed."
        return 0
    fi

    echo "Installing $NAME..."
    TEMP_DIR=$(mktemp -d)
    echo "Downloading from: $URL"
    if ! curl -fsSL --retry 3 --retry-delay 2 "$URL" -o "$TEMP_DIR/download.tar.gz"; then
        echo "⚠️  Failed to download $NAME from $URL"
        rm -rf "$TEMP_DIR"
        fail_tool "$NAME"
        return 1
    fi

    # Extract
    if ! tar -xzf "$TEMP_DIR/download.tar.gz" -C "$TEMP_DIR"; then
        echo "⚠️  Failed to extract $NAME (corrupt download?)"
        rm -rf "$TEMP_DIR"
        fail_tool "$NAME"
        return 1
    fi

    # Find binary and move
    if ! find "$TEMP_DIR" -name "$BIN_NAME" -type f -exec mv {} "$BIN_DIR/$CMD_NAME" \; || [ ! -f "$BIN_DIR/$CMD_NAME" ]; then
        echo "⚠️  Failed to extract binary $BIN_NAME for $NAME"
        rm -rf "$TEMP_DIR"
        fail_tool "$NAME"
        return 1
    fi
    chmod +x "$BIN_DIR/$CMD_NAME"

    rm -rf "$TEMP_DIR"

    # A binary that cannot execute (wrong libc/arch) counts as missing too, so the
    # next run retries instead of the health check alone failing forever.
    if ! "$BIN_DIR/$CMD_NAME" --version >/dev/null 2>&1; then
        echo "⚠️  $BIN_DIR/$CMD_NAME was installed but does not run."
        fail_tool "$NAME"
        return 1
    fi

    echo "✓ $NAME installed to $BIN_DIR/$CMD_NAME"
    return 0
}

# 1. ripgrep (rg)
# https://github.com/BurntSushi/ripgrep
RG_VERSION="14.1.0"
RG_URL="https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/ripgrep-${RG_VERSION}-${RG_ARCH}.tar.gz"
install_binary "ripgrep" "$RG_URL" "rg" "rg"

# 2. bat
# https://github.com/sharkdp/bat
BAT_VERSION="v0.26.1"
BAT_URL="https://github.com/sharkdp/bat/releases/download/${BAT_VERSION}/bat-${BAT_VERSION}-${BAT_ARCH}.tar.gz"
install_binary "bat" "$BAT_URL" "bat"

# 3. eza
# https://github.com/eza-community/eza
EZA_VERSION="v0.18.11"
EZA_URL="https://github.com/eza-community/eza/releases/download/${EZA_VERSION}/eza_${EZA_ARCH}.tar.gz"
install_binary "eza" "$EZA_URL" "eza"

# 4. fd
# https://github.com/sharkdp/fd
FD_VERSION="v10.3.0"
FD_URL="https://github.com/sharkdp/fd/releases/download/${FD_VERSION}/fd-${FD_VERSION}-${FD_ARCH}.tar.gz"
install_binary "fd" "$FD_URL" "fd"

# 5. zoxide
if command -v zoxide >/dev/null 2>&1; then
    echo "✓ zoxide is already installed."
elif curl -fsSL --retry 3 --retry-delay 2 https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash; then
    echo "✓ zoxide installed."
else
    echo "⚠️  zoxide install failed."
    fail_tool zoxide
fi

# 6. fzf
if command -v fzf >/dev/null 2>&1; then
    echo "✓ fzf is already installed."
# The clone is reused if a previous run left it behind; rm -rf ~/.fzf to re-clone.
elif ( [ -d "$HOME/.fzf" ] || git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf" ) \
    && "$HOME/.fzf/install" --bin --no-update-rc \
    && ln -sf "$HOME/.fzf/bin/fzf" "$BIN_DIR/fzf"; then
    echo "✓ fzf installed."
else
    echo "⚠️  fzf install failed (run 'rm -rf ~/.fzf' to force a fresh clone)."
    fail_tool fzf
fi

# Pi-Bolt is installed by 30-install-pi-bolt (Linux and macOS).

echo "========================================"

if [ -n "$FAILED" ]; then
    echo "Still missing:$FAILED"
    echo "Re-run './install.sh' (or 'chezmoi apply') to retry just those."
else
    echo "All Linux binaries in place."
fi

echo "========================================"

# Always exit 0: a missing optional tool is reported by 99-health-check (which
# fails CI), it must never abort the apply for the rest of the dotfiles.
exit 0

{{ end }}
