#!/bin/bash

# .chezmoiscripts/run_after_99-health-check.sh.tmpl
# Performs the final health check on installed tools.
#
# The "99-" prefix keeps this last inside the run_after_* group, so it reports on
# everything 10-install-permission-modes could still have installed. Nothing here
# installs anything: a missing tool is a warning locally (exit 0, so the apply
# does not fail) and a hard failure in CI. The point of exit 0 outside CI is that
# re-running './install.sh' or 'chezmoi apply' retries whatever is missing.

set -e
set -o pipefail  # Fail if any command in a pipe fails (important for version checks)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo ""
echo "========================================"
echo "Final Health Check"
echo "========================================"

failed=0

check_tool() {
    local cmd=$1
    local name=${2:-$cmd}

    printf "Checking %-15s ... " "$name"

    if command -v "$cmd" >/dev/null 2>&1; then
        # Try to get version. Most modern tools support --version.
        # We capture output and silence errors just in case, but return status matters.
        # Due to set -o pipefail, if $cmd fails, the whole pipeline fails.
        if version_out=$("$cmd" --version 2>&1 | head -n 1); then
             printf "${GREEN}✅ Found${RESET} (%s)\n" "$version_out"
        else
             printf "${RED}❌ Failed${RESET} (Version check failed)\n"
             failed=1
        fi
    else
        printf "${RED}❌ Missing${RESET}\n"
        failed=1
    fi
}

# Add local bin directories to PATH for the check
# This ensures we pick up the tools we just installed
export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$HOME/.local/bin:$HOME/.fzf/bin:$PATH"

# 1. Core CLI Tools
check_tool "rg" "ripgrep"
check_tool "bat"
check_tool "eza"
check_tool "fd"
check_tool "zoxide"
check_tool "fzf"

# fish is only needed to use the managed ~/.config/fish/config.fish; the rest of
# the setup works fine from bash/zsh, so a missing fish is not a failure.
printf "Checking %-15s ... " "fish"
if command -v fish >/dev/null 2>&1; then
    printf "${GREEN}✅ Found${RESET} (%s)\n" "$(fish --version 2>&1)"
else
    printf "${YELLOW}⚠️  Missing${RESET} (optional: install 'fish' to use the managed fish config)\n"
fi

# 2. Development Tools
check_tool "pi-bolt" "Pi-Bolt"
check_tool "chezmoi"

{{ if eq .chezmoi.os "linux" -}}
# 3. Optional: OS sandbox for the Pi-Bolt permission modes (bubblewrap + socat;
#    ripgrep is already checked above). Not fatal: without them the sandboxed
#    modes degrade to prompting only and say so in the footer.
printf "Checking %-15s ... " "bwrap/socat"
if command -v bwrap >/dev/null 2>&1 && command -v socat >/dev/null 2>&1; then
    printf "${GREEN}✅ Found${RESET} (%s, %s)\n" "$(bwrap --version 2>&1)" "$(socat -V 2>&1 | sed -n 2p)"
elif [ -n "${CI:-}" ]; then
    printf "${YELLOW}skipped (CI)${RESET}\n"
else
    printf "${YELLOW}⚠️ Missing${RESET} (permission-mode sandbox falls back to prompting only)\n"
fi
{{ end -}}

echo "========================================"

if [ $failed -ne 0 ]; then
    echo ""
    if [ -n "${CI:-}" ]; then
        printf "${RED}Health check failed! Some tools are missing or not working.${RESET}\n"
        exit 1
    fi
    # Outside CI a missing tool should not mark the whole dotfiles apply as failed.
    printf "${YELLOW}Health check: some tools are missing or not working (see above).${RESET}\n"
    printf "${YELLOW}Re-run './install.sh' (or 'chezmoi apply') - the install scripts only fetch what is still missing.${RESET}\n"
    exit 0
else
    echo ""
    printf "${GREEN}All systems operational! Dotfiles installed successfully.${RESET}\n"
    exit 0
fi
