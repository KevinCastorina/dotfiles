#!/bin/bash

# .chezmoiscripts/run_onchange_install-gondolin.sh.tmpl
# Installs Gondolin (https://github.com/earendil-works/gondolin) as a Pi-Bolt
# extension so read/write/edit/bash run inside a QEMU micro-VM.
#
# No admin/root required: node and qemu come from Homebrew (the Linuxbrew prefix
# is user-owned), the extension lives in ~/.pi/agent/extensions/gondolin, and the
# guest image assets are cached in ~/.cache/gondolin.
#
# The extension itself is managed by chezmoi:
#   dot_pi/agent/extensions/gondolin/{index.ts,package.json} -> ~/.pi/...
# This script only provisions the runtime deps and the npm packages.
#
# Network policy: every host is allowed except the deny list in the extension
# (default: aliyuncs.com + *.aliyuncs.com). Override without re-applying:
#   GONDOLIN_BLOCK_HOSTS="aliyuncs.com,*.aliyuncs.com,*.internal.example" pi-bolt

{{ if and (eq .chezmoi.os "linux") (ne .chezmoi.arch "armv6") (ne .chezmoi.arch "armv7") -}}

set -o pipefail

EXT_DIR="$HOME/.pi/agent/extensions/gondolin"

echo "========================================"
echo "Installing Gondolin (Pi sandbox VM)"
echo "========================================"

if [ -n "${CI:-}" ]; then
    echo "CI environment detected - skipping the Gondolin install (QEMU is heavy)."
    exit 0
fi

# Homebrew is the only no-root source for node >= 22.19 and qemu.
if ! command -v brew >/dev/null 2>&1; then
    if [ -d "/home/linuxbrew/.linuxbrew" ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -d "$HOME/.linuxbrew" ]; then
        eval "$($HOME/.linuxbrew/bin/brew shellenv)"
    fi
fi
export PATH="/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$HOME/.local/bin:$PATH"

if ! command -v brew >/dev/null 2>&1; then
    echo "⚠️  Homebrew not found. Gondolin needs Homebrew for node/qemu (there is no sudo path). Skipping."
    exit 0
fi

# 1. Runtime deps: node >= 22.19 (gondolin's engines field) and qemu-system-x86_64.
needs_node() {
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number);
             process.exit(major > 22 || (major === 22 && minor >= 19) ? 0 : 1)' 2>/dev/null
}

if ! needs_node || ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "Installing node and qemu via Homebrew (bottles; no source build unless a bottle is missing)..."
    if brew install node qemu >/dev/null 2>&1; then
        echo "✓ node $(node --version 2>/dev/null), qemu $(qemu-system-x86_64 --version 2>/dev/null | head -n 1)"
    else
        echo "⚠️  'brew install node qemu' failed. Gondolin stays unusable until both are available."
        exit 0
    fi
fi

if [ ! -f "$EXT_DIR/index.ts" ]; then
    echo "⚠️  $EXT_DIR/index.ts is missing (chezmoi did not apply it). Skipping npm install."
    exit 0
fi

# 2. Gondolin package + QEMU runner, pinned to the exact tested version.
#    --ignore-scripts keeps dependency lifecycle scripts from touching the host.
if [ ! -d "$EXT_DIR/node_modules/@earendil-works/gondolin" ]; then
    echo "Installing @earendil-works/gondolin into $EXT_DIR..."
    if ! (cd "$EXT_DIR" && npm install --ignore-scripts --no-audit --no-fund >/dev/null 2>&1); then
        echo "⚠️  npm install failed (no network?). Re-run 'chezmoi apply' later."
        exit 0
    fi
fi

# 3. Smoke test: boot a micro-VM, run a command inside it, and confirm the host-side
#    egress mediation honours an allowlist (unlisted hosts must come back 403).
#    The first boot downloads the guest assets into ~/.cache/gondolin (~300 MB).
if command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "Smoke-testing the micro-VM..."
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_DIR"' EXIT
    ln -s "$EXT_DIR/node_modules" "$TMP_DIR/node_modules"

    cat > "$TMP_DIR/smoke.mjs" <<'SMOKE'
import { createHttpHooks, VM } from "@earendil-works/gondolin";
const vm = await VM.create({ httpHooks: createHttpHooks({ allowedHosts: ["example.com"] }) });
const r = await vm.exec("/bin/bash -lc 'curl -sS -o /dev/null -w \"%{http_code}\\n\" https://example.com; curl -sS -o /dev/null -w \"%{http_code}\\n\" https://oss.aliyuncs.com'");
console.log("guest:", (r.stdout ?? "").trim(), "| stderr:", (r.stderr ?? "").trim(), "| exit", r.exitCode);
await vm.close();
SMOKE

    if node "$TMP_DIR/smoke.mjs" 2>&1 | tail -n 3; then
        echo "✓ Gondolin VM works (allowlisted host reachable, others blocked)."
    else
        echo "⚠️  Gondolin smoke test failed. Check 'qemu-system-x86_64 --version' and ~/.cache/gondolin."
    fi
fi

echo "========================================"
{{ end -}}
