#!/bin/bash

# .chezmoiscripts/run_after_health-check.sh.tmpl
# Performs a final health check on installed tools.

set -e
set -o pipefail  # Fail if any command in a pipe fails (important for version checks)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo ""
echo "========================================"
echo "Final Health Check"
echo "========================================"

failed=0

check_tool() {
    local cmd=$1
    local name=${2:-$cmd}

    printf "Checking %-15s ... " "$name"

    if command -v "$cmd" >/dev/null 2>&1; then
        # Try to get version. Most modern tools support --version.
        # We capture output and silence errors just in case, but return status matters.
        # Due to set -o pipefail, if $cmd fails, the whole pipeline fails.
        if version_out=$("$cmd" --version 2>&1 | head -n 1); then
             printf "${GREEN}✅ Found${RESET} (%s)\n" "$version_out"
        else
             printf "${RED}❌ Failed${RESET} (Version check failed)\n"
             failed=1
        fi
    else
        printf "${RED}❌ Missing${RESET}\n"
        failed=1
    fi
}

# Add local bin directories to PATH for the check
# This ensures we pick up the tools we just installed
export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$HOME/.local/bin:$HOME/.fzf/bin:$PATH"

# 1. Core CLI Tools
check_tool "rg" "ripgrep"
check_tool "bat"
check_tool "eza"
check_tool "fd"
check_tool "zoxide"
check_tool "fzf"

# 2. Development Tools
check_tool "pi-bolt" "Pi-Bolt"
check_tool "chezmoi"

{{ if eq .chezmoi.os "linux" -}}
# 3. Optional: Gondolin micro-VM sandbox (read/write/edit/bash inside QEMU).
#    Not fatal: CI runs skip the install, and a missing qemu only means the
#    sandbox extension cannot boot a VM.
printf "Checking %-15s ... " "qemu/gondolin"
if command -v qemu-system-x86_64 >/dev/null 2>&1; then
    printf "${GREEN}✅ Found${RESET} (%s)\n" "$(qemu-system-x86_64 --version 2>&1 | head -n 1)"
elif [ -n "${CI:-}" ]; then
    printf "${YELLOW}skipped (CI)${RESET}\n"
else
    printf "${YELLOW}⚠️ Missing${RESET} (Gondolin sandbox unavailable)\n"
fi
{{ end -}}

echo "========================================"

if [ $failed -ne 0 ]; then
    echo ""
    if [ -n "${CI:-}" ]; then
        printf "${RED}Health check failed! Some tools are missing or not working.${RESET}\n"
        exit 1
    fi
    # Outside CI a missing tool should not mark the whole dotfiles apply as failed.
    printf "${YELLOW}Health check: some tools are missing or not working (see above). Re-run 'chezmoi apply' to retry.${RESET}\n"
    exit 0
else
    echo ""
    printf "${GREEN}All systems operational! Dotfiles installed successfully.${RESET}\n"
    exit 0
fi
