# CLI tools - Homebrew installs bottles for all of these on both macOS and
# Linux, so nothing is compiled and no root is needed.
brew "ripgrep"
brew "bat"
brew "eza"
brew "fzf"
brew "zoxide"
brew "fd"

# fish shell (the managed ~/.config/fish/config.fish needs it)
brew "fish"
{{ if eq .chezmoi.os "linux" }}
# Pi-Bolt permission-mode sandbox: the OS sandbox + network bridge. See
# .chezmoiscripts/run_after_10-install-permission-modes.sh.tmpl.
brew "bubblewrap"
brew "socat"
{{- end }}

# Pi-Bolt is installed via its official installer in run_before_30-install-pi-bolt.sh.tmpl
brew "chezmoi"
{{ if eq .chezmoi.os "darwin" }}

# homebrew/cask-fonts is deprecated, fonts are now in homebrew/cask
cask "font-fira-code-nerd-font"
{{- end }}
